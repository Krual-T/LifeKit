# Keep repository-owned skills; machine-local installs need explicit review.
/*
!/.gitignore
!/skills/
/skills/*
!/skills/find-methodology/
!/skills/research/
!/skills/research-pack/
/skills/research-pack/*
!/skills/research-pack/pytorch-patterns/
!/skills/writing-pack/
/skills/writing-pack/*
!/skills/writing-pack/ai-writing-rules/
!/skills/writing-pack/presentation-style/
!/skills/writing-pack/read-local-documents/
!/skills/writing-pack/markdown-to-pdf/
!/skills/engineering-pack/
/skills/engineering-pack/*
!/skills/engineering-pack/product-management/
!/skills/engineering-pack/write-technical-design/
!/skills/engineering-pack/orchestrate-subagents/
!/skills/memory-pack/
/skills/memory-pack/*
!/skills/memory-pack/using-wiki/
!/skills/memory-pack/periodic-review/

# Third-party reference library is restored at the pinned version on demand.
/skills/engineering-pack/product-management/references/.library/
