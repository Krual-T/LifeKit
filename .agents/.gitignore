# Keep repository-owned skills; machine-local installs need explicit review.
/*
!/.gitignore
!/skills/
/skills/*
!/skills/using-wiki/
!/skills/orchestrate-subagents/
!/skills/write-technical-design/
!/skills/research/
!/skills/output-style/
!/skills/read-local-documents/
!/skills/product-management/
!/skills/markdown-to-pdf/
!/skills/write/
/skills/write/*
!/skills/write/ai-writing-rules/

# Third-party reference library is restored at the pinned version on demand.
/skills/product-management/references/.library/
